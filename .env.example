# --- Servidor ---
PORT=3001
# Postgres de docker-compose (puerto 5433 para no chocar con un Postgres local)
DATABASE_URL=postgresql://quiz:quiz@localhost:5433/quiz
# Clave para entrar como anfitrión (crear quizzes, lanzar partidas, ver el historial)
HOST_PASSWORD=anfitrion
# Firma los tokens de sesión del anfitrión (32+ caracteres)
SESSION_SECRET=genera-uno-largo-y-aleatorio
# Orígenes permitidos por CORS, separados por coma (en producción: la URL de Netlify)
CLIENT_ORIGIN=http://localhost:5173

# --- Cliente ---
# Vacío en desarrollo (Vite hace proxy de /api y /socket.io).
# En Netlify: la URL pública del backend, p. ej. https://quizlive-server.up.railway.app
VITE_SERVER_URL=
# Dirección que el lobby anuncia a los jugadores (QR y enlace corto). Vacía = la de la propia página.
# En producción: https://quizlivee.vercel.app (Vercel; variables en el panel del proyecto)
VITE_PUBLIC_URL=
