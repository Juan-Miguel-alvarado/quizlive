generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id            String     @id @default(cuid())
  title         String
  // Puntaje: puntos fijos por acertar + bono por rapidez (de bono completo al instante a 0 al final).
  pointsCorrect Int        @default(100)
  speedBonusMax Int        @default(50)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  series        Series[]
  questions     Question[]
  games         Game[]
}

// Grupo de preguntas dentro de una trivia (p. ej. "¿Quién dijo?"). Al final de cada serie se ve el top 5.
model Series {
  id        String     @id @default(cuid())
  quizId    String
  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  questions Question[]

  @@unique([quizId, order])
}

enum QuestionType {
  single
  multiple
  truefalse
}

model Question {
  id             String       @id @default(cuid())
  quizId         String
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  seriesId       String
  series         Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  order          Int // orden global dentro de la trivia (el historial lo usa como número de pregunta)
  type           QuestionType @default(single)
  text           String
  imageId        String?
  image          Image?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  options        String[]
  correctIndices Int[]
  timeLimitSec   Int
  explanation    String? // se muestra al revelar la respuesta (dato o versículo)

  @@unique([quizId, order])
}

// Las imágenes viven en Postgres: el cliente las reduce antes de subirlas y así
// el despliegue no necesita un almacenamiento de archivos aparte.
model Image {
  id        String     @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime   @default(now())
  questions Question[]
}

// Resultado de una partida terminada. El historial sobrevive aunque se borre el quiz.
model Game {
  id         String         @id @default(cuid())
  quizId     String?
  quiz       Quiz?          @relation(fields: [quizId], references: [id], onDelete: SetNull)
  quizTitle  String
  pin        String
  startedAt  DateTime
  finishedAt DateTime
  players    PlayerResult[]
}

model PlayerResult {
  id       String       @id @default(cuid())
  gameId   String
  game     Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nickname String
  score    Int
  rank     Int
  answers  GameAnswer[]
}

// Guarda una copia del texto de la pregunta: editar el quiz después no altera el historial.
model GameAnswer {
  id             String       @id @default(cuid())
  playerResultId String
  player         PlayerResult @relation(fields: [playerResultId], references: [id], onDelete: Cascade)
  questionOrder  Int
  questionText   String
  choices        Int[]        // vacío = no respondió
  correct        Boolean
  points         Int
  responseMs     Int?
}
