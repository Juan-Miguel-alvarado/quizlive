{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p .",
    "postinstall": "prisma generate",
    "test:e2e": "tsx scripts/e2e.ts",
    "bots": "tsx scripts/bots.ts",
    "start": "prisma generate && prisma migrate deploy && tsx src/index.ts",
    "test:load": "tsx scripts/load.ts",
    "test": "vitest run",
    "seed:biblia": "tsx scripts/seed-trivia.ts",
    "images:biblia": "tsx scripts/add-images.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@quiz/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "prisma": "7.10.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.3",
    "vitest": "^3.2.7"
  }
}
